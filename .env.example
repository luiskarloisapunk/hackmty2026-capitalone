NESSIE_API_KEY=tu_api_key_aqui
NESSIE_BASE_URL=https://api.nessieisreal.com
BANXICO_TOKEN=tu_token_sie_banxico_aqui
JWT_SECRET_KEY=genera_una_con_python_-c_"import secrets; print(secrets.token_hex(32))"

# Con MONGODB_URI definida, docker-compose la usa y el stack pega a la
# misma base que `make dev` (los datos se comparten con el equipo). Si la
# dejas vacía, cae al Mongo del propio contenedor: autocontenido, sin
# necesidad de credenciales, pero con datos aparte.
MONGODB_URI=tu_connection_string_de_mongodb_atlas_aqui

# Nota: docker-compose lee este .env (raíz del repo) para el backend.
