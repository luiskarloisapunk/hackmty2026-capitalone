server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Proxy /api/* → backend. ${BACKEND_HOST} lo resuelve el entrypoint de
    # nginx al arrancar: "backend" en modo red bridge, "127.0.0.1" cuando
    # se corre con network_mode: host.
    #
    # El upstream va en una variable a propósito: con el nombre literal,
    # nginx lo resuelve al arrancar y el contenedor entero se cae con
    # "host not found in upstream" si el backend todavía no existe. Con
    # variable más resolver (127.0.0.11 es el DNS interno de Docker), la
    # resolución ocurre en cada request: el frontend estático sigue
    # sirviendo aunque el backend esté caído o reiniciándose.
    location /api/ {
        resolver           127.0.0.11 ipv6=off valid=10s;
        set                $backend_upstream ${BACKEND_HOST};
        proxy_pass         http://$backend_upstream:8000$request_uri;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }

    # SPA fallback: rutas de React Router devuelven index.html
    location / {
        try_files $uri $uri/ /index.html;
    }
}
